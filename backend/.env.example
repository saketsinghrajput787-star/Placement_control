# ==========================================
# Placement Control Tower - Backend Environment Template
# ==========================================

PROJECT_NAME="AI-Assisted Placement Control Tower"
VERSION="1.0.0"
DEMO_MODE=false
DATABASE_URL="postgresql://placement_admin:password@localhost:5432/placement_tower"
SECRET_KEY="replace-with-a-secure-random-secret-key-at-least-32-chars"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Copilot via Groq
GROQ_API_KEY="gsk_your_groq_api_key_here"
GROQ_MODEL="openai/gpt-oss-120b"

# CORS configuration (comma separated list of allowed web origins)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,https://placement-control-tower.vercel.app"
