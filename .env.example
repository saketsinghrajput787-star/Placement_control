# Backend Environment Variables
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/placement_tower
# Alternatively for local development without postgres running:
# DATABASE_URL=sqlite:///./placement_tower.db

SECRET_KEY=placement-tower-production-super-secret-key-32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Groq API Integration (LLM Copilot)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# CORS Configuration
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","https://placement-control-tower.vercel.app"]

# Frontend Environment Variables
VITE_API_URL=http://localhost:8000
